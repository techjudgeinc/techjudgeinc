---
import SiteLayout from '../layouts/SiteLayout.astro';
import TechnologyStory from '../components/TechnologyStory.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import {googleRating,googleReviewsUrl} from '../data/reviews';
import ContactBand from '../components/ContactBand.astro';
import {asset} from '../lib/assets';
import baseline from '../data/baseline.json';
const services=[
 {n:'01',name:'Managed IT & Cybersecurity',caption:'A stronger business starts here.',text:'Proactive IT support, layered security and cloud services. Technology your team can count on, with one partner to manage it.',href:'/it-and-cyber-security',image:asset('005.png'),alt:'IT professional working in a server room'},
 {n:'02',name:'Infrastructure & Security',caption:'Built right. Connected for the long run.',text:'From structured cabling and enterprise Wi-Fi to access control and surveillance. The physical foundation for everything you do.',href:'/infrastructure-and-security',image:asset('064.png'),alt:'Structured network cabling and switches'},
 {n:'03',name:'Luxury Smart Homes',caption:'Extraordinary technology. Effortless living.',text:'Control4, Lutron and integrated audio/video, brought together in a home that responds naturally to you.',href:'/luxury-smart-home',image:asset('078.png'),alt:'A contemporary living room with integrated home technology'}
];
const industries=[['Small & medium businesses','Keep your people productive.','/small-medium-businesses'],['Property management','Connect and protect your portfolio.','/property-management'],['General contractors','One partner for the low-voltage scope.','/general-contractors'],['Architects & designers','Technology that respects the design.','/architects-designers'],['Luxury home builders','From blueprint to final handover.','/luxury-home-builders']];
---
<SiteLayout {...baseline['/']}>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow">Business. Buildings. Home.</p><h1>Every system.<br/><em>One partner.</em></h1><p class="hero-description">One accountable team to design, install and support your IT, security and smart-home technology.</p><div class="hero-actions"><a class="button" href="/contact-us">Talk to our team <span aria-hidden="true">↗</span></a><a class="text-link" href="/services">Explore our expertise <span aria-hidden="true">→</span></a></div><div class="hero-proof"><span>California C7 licensed</span><span>Based in Chatsworth, CA</span></div></div>
    <div class="hero-visual"><img src={asset('099.png')} width="600" height="720" alt="Organized technology infrastructure in a modern commercial space" fetchpriority="high" /><div class="image-shade"></div><div class="visual-label"><span class="eyebrow">The details make the difference.</span><p>Connected.<br/>Considered.<br/><em>Completely handled.</em></p></div><span class="visual-index" aria-hidden="true">TJ / 01</span></div>
  </section>
  <div class="wrap google-rating-intro"><a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">★★★★★</span> {googleRating.score} / 5 · {googleRating.count} Google reviews ↗</a><small>Checked <time datetime={googleRating.date}>{googleRating.checked}</time></small></div>
  <section class="partner-strip"><div class="wrap"><p>Built with technology<br/>you already trust.</p><div>{['unifi-logo-014.svg','sentinel-one-logo-015.svg','axis-communication-logo-016.svg','control-4-logo-023.svg','lutron-logo-025.svg'].map(s=><img src={asset(s)} width="130" height="42" alt={s.split('-logo')[0].replaceAll('-',' ')} />)}</div><a href="/partners" aria-label="View all technology partners">All partners <span aria-hidden="true">↗</span></a></div></section>
  <TechnologyStory />
  <section class="section light" id="expertise"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Three disciplines. One team.</p><h2>Technology that works<br/>together. <em>For you.</em></h2></div><p>A business to run. A building to connect. A home to bring to life. We bring the expertise and take ownership of the whole picture.</p></div><div class="service-grid">{services.map(s=><a class="service-card" href={s.href}><div class="service-image"><img src={s.image} width="560" height="400" alt={s.alt} loading="lazy" /><span>{s.n}</span></div><div class="service-copy"><h3>{s.name}</h3><p class="service-caption">{s.caption}</p><p>{s.text}</p><span class="card-link">Explore solutions <span aria-hidden="true">↗</span></span></div></a>)}</div></div></section>
  <section class="section philosophy"><div class="wrap split"><div><p class="eyebrow">Less complexity. More confidence.</p><h2>Stop coordinating vendors.<br/><em>Start moving forward.</em></h2><p class="lead">Your network, security and day-to-day technology should support each other. So should the people behind them.</p><a href="/about-us" class="text-link">Meet your technology partner <span aria-hidden="true">↗</span></a></div><div class="principles">{[['01','One point of accountability','One team to design, install and manage your technology, from the server rack to the light switch.'],['02','Expertise across the whole system','IT specialists, C7-licensed infrastructure expertise and smart-home integration under one roof.'],['03','A foundation for what comes next','Thoughtful planning, reliable equipment and support that keeps the bigger picture in view.']].map(([n,t,p])=><div><span>{n}</span><div><h3>{t}</h3><p>{p}</p></div></div>)}</div></div></section>
  <section class="section light"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Built around your world</p><h2>Different environments.<br/><em>The same commitment.</em></h2></div><a class="text-link" href="/industries">See who we work with <span aria-hidden="true">↗</span></a></div><div class="industry-list">{industries.map(([name,text,href],i)=><a href={href}><span class="list-number">0{i+1}</span><h3>{name}</h3><p>{text}</p><span class="round-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
  <GoogleReviews />
  <ContactBand />
</SiteLayout>
