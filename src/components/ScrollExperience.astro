<script>
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const narrow=matchMedia('(max-width: 900px)');
 const story=document.querySelector<HTMLElement>('.technology-story');
 const scenes=Array.from(document.querySelectorAll<HTMLElement>('.story-scene'));
 const paused=()=>document.documentElement.classList.contains('motion-paused')||reduced.matches;
 const graphicObserver=new IntersectionObserver(entries=>entries.forEach(entry=>entry.target.classList.toggle('graphic-visible',entry.isIntersecting)),{rootMargin:'60px'});
 document.querySelectorAll('.technology-graphic').forEach(el=>graphicObserver.observe(el));
 // Only enhance content below the opening viewport. The first screen never waits.
 const revealObserver=new IntersectionObserver(entries=>{
   for(const entry of entries)if(entry.isIntersecting){const el=entry.target as HTMLElement;el.classList.add('is-revealed');revealObserver.unobserve(el);setTimeout(()=>el.classList.remove('reveal-pending','is-revealed'),1300);}
 },{threshold:.08,rootMargin:'0px 0px -25px 0px'});
 if(!paused())document.querySelectorAll<HTMLElement>('main h2,main .section-heading>p,main .content-intro>.lead,main .prose>p,.service-card,.industry-list>a,.process-grid>div,.scope-sections>section,.review-card,.audience-card,.brand-grid>div,.principles>div').forEach((el,i)=>{
  if(el.closest('.story-scene,.story-intro,.planner-result')||el.getBoundingClientRect().top<innerHeight*.94)return;
  el.style.setProperty('--reveal-delay',`${i%3*70}ms`);el.classList.add('reveal-pending');revealObserver.observe(el);
 });
 function configureStory(){
  if(!story)return;
  const enabled=!paused()&&!narrow.matches;
  story.classList.toggle('story-enhanced',enabled);
  scenes.forEach(el=>{if(!enabled){el.removeAttribute('aria-hidden');el.classList.remove('is-current');}});
 }
 function frame(){
  const max=document.documentElement.scrollHeight-innerHeight;
  document.documentElement.style.setProperty('--page-progress',String(max>0?Math.min(1,scrollY/max):0));
  if(story?.classList.contains('story-enhanced')){
   const rect=story.getBoundingClientRect();const progress=Math.max(0,Math.min(1,(76-rect.top)/(story.offsetHeight-innerHeight+76)));
   const index=Math.min(2,Math.floor(progress*3));
   story.style.setProperty('--story-progress',String((index+1)/3));story.style.setProperty('--story-tilt',`${(progress*3-index-.5)*6}deg`);
   scenes.forEach((el,i)=>{el.classList.toggle('is-current',i===index);el.setAttribute('aria-hidden',String(i!==index));});
   story.querySelector('.story-counter')!.textContent=`0${index+1} / 03`;
  }
  if(!paused())document.querySelectorAll<HTMLElement>('.hero-visual,.detail-image').forEach(el=>{const rect=el.getBoundingClientRect();if(rect.bottom>0&&rect.top<innerHeight)el.style.setProperty('--image-scale',String(1+Math.max(0,-rect.top)/innerHeight*.055));});
 }
 let queued=false;
 const schedule=()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;frame();});}};
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule,{passive:true});
 const update=()=>{configureStory();if(paused())document.querySelectorAll('.reveal-pending').forEach(el=>el.classList.add('is-revealed'));schedule();};
 // The site's motion control applies to the storytelling and diagrams as well.
 new MutationObserver(update).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
 reduced.addEventListener('change',update);narrow.addEventListener('change',update);update();
</script>
