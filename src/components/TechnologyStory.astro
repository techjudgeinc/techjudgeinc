---
import TechnologyGraphic from './TechnologyGraphic.astro';
---
<section class="technology-story" aria-label="Our connected approach">
 <div class="story-sticky wrap">
  <div class="story-intro"><p class="eyebrow">See the whole picture</p><h2>Every layer.<br/><em>Working together.</em></h2><p class="lead">Technology works best when every part is considered. Scroll through the connections that make it happen.</p><a class="text-link" href="/services">Explore our expertise <span aria-hidden="true">↗</span></a><div class="story-meter" aria-hidden="true"><span></span></div><span class="story-counter" aria-hidden="true">01 / 03</span></div>
  <div class="story-scenes">
   {[
    {kind:'network',title:'Connect the foundation.',text:'Networks, cabling and infrastructure designed to support everything above them.',label:'01 / Infrastructure'},
    {kind:'security',title:'Protect what matters.',text:'Layered cybersecurity and access controls built around your people and systems.',label:'02 / Security'},
    {kind:'home',title:'Make it feel effortless.',text:'Intuitive technology, thoughtful integration and one team to keep it working.',label:'03 / Experience'}
   ].map((scene,i)=><article class="story-scene" data-scene={i}><TechnologyGraphic kind={scene.kind} caption={scene.label}/><h3>{scene.title}</h3><p>{scene.text}</p></article>)}
  </div>
 </div>
</section>
