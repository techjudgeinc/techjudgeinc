---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import baseline from '../data/baseline.json';
const staging=import.meta.env.PUBLIC_CONTACT_ENABLED!=='true' || !import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const topics=['Managed IT & Cybersecurity','Infrastructure & Security','Luxury Smart Homes','Small & Medium Businesses','Property Management','General Contractors','Architects & Designers','Luxury Home Builders','Something else'];
---
<SiteLayout path="/contact-us" {...baseline['/contact-us']}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ContactPage',name:'Contact Tech Judge',url:'https://www.techjudge.com/contact-us',mainEntity:{'@id':'https://www.techjudge.com/#organization'}})}/>
  <PageHeader eyebrow="Let’s talk" title="Let’s talk about what you need." intro="Something’s not working, a new space needs a network, or you’re ready to plan a home project. Tell us where you’re starting." />
  <section class="section light contact-section"><div class="wrap contact-layout"><div><h2 id="contact-form-heading">What’s on your mind?</h2>{staging && <p class="review-note">This is a staging preview. You can review a message below; it will not be sent.</p>}
  <form id="enquiry" data-preview={staging?'true':'false'} method="post" action="/api/contact">
    <div class="form-grid"><div class="field"><label for="name">Full name <span>(required)</span></label><input id="name" name="name" autocomplete="name" maxlength="120" required /></div><div class="field"><label for="email">Email address <span>(required)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div><div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" maxlength="160" /></div><div class="field full"><label for="service">What can we help with? <span>(required)</span></label><select id="service" name="service" required><option value="">Choose a service or project</option>{topics.map(t=><option>{t}</option>)}</select></div><div class="field"><label for="location">Project city or ZIP code</label><input id="location" name="location" autocomplete="address-level2" maxlength="120"/></div><div class="field"><label for="timeline">When do you need help?</label><select id="timeline" name="timeline"><option value="">Choose a timeframe</option><option>As soon as possible</option><option>Within a month</option><option>In the next few months</option><option>Still planning</option></select></div><div class="field full"><label for="preference">What would you like to do next?</label><select id="preference" name="preference"><option>Talk through the project</option><option>Request a site walk</option><option>Discuss monthly IT support</option></select></div><div class="field full"><label for="message">Your message <span>(required)</span></label><textarea id="message" aria-describedby="message-help" name="message" rows="6" minlength="10" maxlength="5000" required placeholder="A little about the project, location and timeline is a helpful start."></textarea><p id="message-help" class="field-help">Please include at least 10 characters. Maximum 5,000 characters.</p></div></div>
    <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    {!staging && <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-action="contact"></div>}
    <p class="form-privacy">We’ll use your details to respond to this enquiry. {!staging && 'Cloudflare processes the submission and security check; Resend delivers your enquiry to our team. Please do not include passwords or sensitive account information. '}Read our <a href="/privacy-policy">privacy policy</a>.</p>
    <button class="button" type="submit">{staging?'Review message':'Send message'} </button>
    <p id="form-status" role="status" aria-live="polite"></p>
    <section id="message-preview" class="message-preview" hidden tabindex="-1" aria-label="Your message preview"><h3>Your message, ready to review.</h3><p class="review-note">Review only. Nothing has been sent or saved.</p><dl id="preview-fields"></dl><button type="button" id="edit-message" class="text-button">Edit your message </button></section>
    <noscript><p class="review-note">To reach our team, email <a href="mailto:info@techjudge.com">info@techjudge.com</a> or call (818) 213-2050. {staging?'The staging form needs JavaScript to show a local preview.':''}</p></noscript>
  </form>
  <section id="contact-success" hidden tabindex="-1" aria-labelledby="contact-success-title" aria-describedby="contact-success-description">
    <div class="success-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M17 23l7-9 1-7c5 0 7 4 5 10l-1 3h8a4 4 0 0 1 4 5l-3 12a4 4 0 0 1-4 3H22l-5-3"/><rect x="7" y="22" width="10" height="19" rx="3"/></svg></div>
    <p class="success-eyebrow">Message received</p>
    <h2 id="contact-success-title">We’ll reach out soon.</h2>
    <p id="contact-success-description">Thanks for getting in touch. Our team will review your enquiry and contact you using the details you provided.</p>
    <a class="text-link" href="/">Back to home <span aria-hidden="true">→</span></a>
  </section></div><aside class="contact-aside"><div><a class="contact-phone" href="tel:+18182132050">(818) 213-2050</a><a href="mailto:info@techjudge.com">info@techjudge.com</a></div><div><h3>Our office</h3><p>21943 Plummer St.<br/>Chatsworth, CA 91311</p><a class="text-link" href="https://share.google/sPEeP7n79I2hqWTM3" target="_blank" rel="noopener noreferrer">View on Google Maps </a></div><div id="client-support"><h3>Already a client?</h3><p>For technical assistance, contact our support team directly.</p><a href="mailto:support@techjudge.com">support@techjudge.com</a><a href="tel:+18182132050">(818) 213-2050</a></div><div><h3>Before we quote</h3><p>We’ll discuss your location, needs, budget and timeline. If a site walk is needed, we’ll arrange it with you.</p><h3 class="spaced">Licensed for the work</h3><p>California C7<br/>License #1142144</p></div></aside></div></section>
  {!staging && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    import {createPlan} from '../lib/it-plan';
    const form=document.querySelector<HTMLFormElement>('#enquiry');
    if(form){
      const service=form.querySelector<HTMLSelectElement>('#service')!;
      const selected=new URLSearchParams(location.search).get('service');
      if(selected&&Array.from(service.options).some(o=>o.value===selected))service.value=selected;
      const planParams=new URLSearchParams(location.search);
      if(planParams.get('visit')==='site-walk')form.querySelector<HTMLSelectElement>('#preference')!.value='Request a site walk';
      if(planParams.get('plan')==='1'){
        const plan=createPlan(planParams);
        if(plan)form.querySelector<HTMLTextAreaElement>('#message')!.value=plan.text;
      }
      form.addEventListener('submit',async e=>{
        e.preventDefault();if(!form.reportValidity())return;
        const data=new FormData(form);const status=document.querySelector<HTMLElement>('#form-status')!;
        if(form.dataset.preview==='true'){
          const target=document.querySelector<HTMLElement>('#message-preview')!;const fields=document.querySelector('#preview-fields')!;
          fields.replaceChildren();
          for(const [key,label] of [['name','Name'],['email','Email'],['phone','Phone'],['company','Company'],['service','Service'],['location','Location'],['timeline','Timeline'],['preference','Next step'],['message','Message']]){
            const value=String(data.get(key)||'');if(!value)continue;
            const dt=document.createElement('dt');dt.textContent=label;const dd=document.createElement('dd');dd.textContent=value;fields.append(dt,dd);
          }
          target.hidden=false;status.textContent='Your preview is ready. No message has been sent.';target.focus();return;
        }
        const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;status.textContent='Sending your message…';
        try{const response=await fetch('/api/contact',{method:'POST',body:data,headers:{Accept:'application/json'}});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Your message could not be sent. Please try again or email info@techjudge.com.');form.reset();form.hidden=true;document.querySelector<HTMLElement>('#contact-form-heading')!.hidden=true;const confirmation=document.querySelector<HTMLElement>('#contact-success')!;confirmation.hidden=false;confirmation.focus();}
        catch(err){status.textContent=err instanceof Error?err.message:'Unable to send. Please contact info@techjudge.com.';button.disabled=false;(window as Window & {turnstile?:{reset:()=>void}}).turnstile?.reset();}
      });
      document.querySelector('#edit-message')?.addEventListener('click',()=>{document.querySelector<HTMLElement>('#message-preview')!.hidden=true;document.querySelector<HTMLInputElement>('#message')?.focus();});
    }
  </script>
</SiteLayout>
<style>
  #contact-success:not([hidden]){display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:390px;text-align:center;padding:32px 0;gap:18px}
  .success-icon{display:grid;place-items:center;width:88px;height:88px;border-radius:50%;background:linear-gradient(135deg,#f5dfac,#c09b56);color:#251e12;box-shadow:0 0 48px #c09b561c;margin-bottom:10px}
  .success-icon svg{width:44px;height:44px}
  #contact-success:not([hidden]) .success-icon{animation:success-pop .7s cubic-bezier(.2,.8,.3,1) both}
  #contact-success:not([hidden]) svg{animation:success-thumb .85s .15s ease both;transform-origin:50% 80%}
  #contact-success .success-eyebrow{margin:0;font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
  #contact-success h2{margin:0;font-size:clamp(30px,3.5vw,44px);line-height:1.12;letter-spacing:-.035em}
  #contact-success-description{max-width:440px;margin:0;color:var(--muted);line-height:1.7}
  #contact-success .text-link{margin-top:12px}
  @keyframes success-pop{from{opacity:0;transform:scale(.8) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)}}
  @keyframes success-thumb{0%,100%{transform:rotate(0)}45%{transform:rotate(-14deg)}70%{transform:rotate(5deg)}}
  @media(prefers-reduced-motion:reduce){#contact-success:not([hidden]) .success-icon,#contact-success:not([hidden]) svg{animation:none}}
  :global(html[data-motion="paused"]) #contact-success:not([hidden]) .success-icon,:global(html[data-motion="paused"]) #contact-success:not([hidden]) svg{animation:none}
</style>
