---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactBand from './ContactBand.astro';
import GoogleReviews from './GoogleReviews.astro';
import {asset} from '../lib/assets';
import {names} from '../data/content';
const {page}=Astro.props;
const path='/'+page.slug;
const generated:Record<string,{src:string,alt:string}>={
 'it-and-cyber-security':{src:'/imagery/managed-it-office.webp',alt:'Illustrative IT workspace with neatly arranged computers and a sunlit office'},
 'infrastructure-and-security':{src:'/imagery/infrastructure-rack.webp',alt:'Illustrative communications rack with organized neutral patch cabling'},
 'luxury-smart-home':{src:'/imagery/smart-home-courtyard.webp',alt:'Illustrative contemporary smart home courtyard with warm architectural lighting'}
};
const illustration=generated[page.slug];
const schema={'@context':'https://schema.org','@type':page.type==='service'?'Service':'WebPage',name:page.name,url:'https://www.techjudge.com'+path,description:page.intro,...(page.type==='service'?{provider:{'@id':'https://www.techjudge.com/#organization'},areaServed:['Los Angeles','San Fernando Valley','Thousand Oaks','Santa Clarita']}:{})};
const contact='/contact-us?service='+encodeURIComponent(page.name)+(page.slug==='infrastructure-and-security'?'&visit=site-walk':'');
---
<SiteLayout title={page.name+' in Los Angeles | Tech Judge'} description={page.intro} path={path}>
 <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)}/>
 <section class="detail-opening wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={page.type==='service'?'/services':'/industries'}>{page.type==='service'?'All services':'Who we work with'}</a><span aria-hidden="true">/</span><span aria-current="page">{page.name}</span></nav><h1>{page.headline}<br/><em>{page.accent}</em></h1><p class="lead">{page.intro}</p><a class="button" href={contact}>{page.cta}</a><div class="detail-wide-media"><img src={illustration?.src||asset(page.image)} width="1200" height="500" alt={illustration?.alt||page.alt} fetchpriority="high"/><span class="detail-media-caption">{page.name}{illustration&&<small>Illustrative image · AI-generated</small>}</span></div></section>
 <section class="section"><div class="wrap"><div class="content-intro" data-reveal><h2>{page.overviewTitle}</h2><p class="lead">{page.overview}</p></div><div class="scope-board">{page.sections.map((s:any)=><section id={s.id} data-reveal><h3>{s.title}</h3><p>{s.text}</p>{s.items&&<ul>{s.items.map((item:string)=><li>{item}</li>)}</ul>}</section>)}</div></div></section>
 {page.slug==='it-and-cyber-security'&&<section class="section"><div class="wrap split" data-reveal><div><h2>An IT team that knows<br/>every office.</h2><p class="lead">For Pinnacle Estate Properties, our work spans network management, agent support, email, VoIP and the infrastructure behind new offices.</p><p class="draft-note">Client feature pending publication approval.</p></div><div class="care-list"><h3>Pinnacle Estate Properties</h3><p class="lead">An ongoing relationship that connects day-to-day help with the work of building and maintaining an office network.</p><a class="text-link spaced" href="/projects/pinnacle-estate-properties">Explore the relationship</a></div></div></section>}
 {page.slug==='infrastructure-and-security'&&<section class="section"><div class="wrap split" data-reveal><h2>Sometimes, the next job<br/>starts with one door.</h2><div class="prose"><p>For a school’s UniFi Access project, we started with a single door so the client could see the installation and use the system. They liked the result and asked us to expand the work to more doors.</p><p>That’s how we prefer to earn trust: through the work itself.</p></div></div></section>}
 <section class="section"><div class="wrap"><h2 data-reveal>Know what happens next.</h2><div class="process-grid">{page.process.map(([title,text]:string[])=><div data-reveal><h3>{title}</h3><p>{text}</p></div>)}</div></div></section>
 {page.slug==='it-and-cyber-security'&&<section class="section light"><div class="wrap split" data-reveal><h2>A useful range.<br/>Before a detailed quote.</h2><div><p class="lead">See how team size and support choices affect a monthly managed IT estimate. We’ll confirm the actual scope and pricing after learning about your environment.</p><a class="button spaced" href="/plan-your-it">Explore monthly pricing</a></div></div></section>}
 <section class="section light"><div class="wrap split"><div><h2>A few things<br/>you might be asking.</h2><a class="text-link spaced" href={contact}>Ask us something else</a></div><div class="faqs">{page.faqs.map(([q,a]:string[])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
 {page.type==='service'&&<GoogleReviews service={page.slug}/>}
 <section class="related-section"><div class="wrap"><h2 class="related-heading">Other ways we can help</h2><div>{page.related.map((slug:string)=><a href={'/'+slug}>{names[slug]}</a>)}</div></div></section>
 <ContactBand heading={page.cta+'.'} topic={page.name}/>
</SiteLayout>
