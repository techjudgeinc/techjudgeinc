---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBand from '../components/ContactBand.astro';
import baseline from '../data/baseline.json';
import {asset} from '../lib/assets';
---
<SiteLayout path="/about-us" {...baseline['/about-us']}>
  <PageHeader eyebrow="About Tech Judge" title="Technology is connected." accent="Your team should be, too." intro="We bring IT, infrastructure and smart-home expertise together to give you one accountable partner for the complete picture." />
  <section class="section light"><div class="wrap split"><div><p class="eyebrow">Our story</p><h2>One company.<br/><em>A wider perspective.</em></h2></div><div class="prose"><p>Tech Judge was founded on a simple premise: managing technology should not be a source of chaos.</p><p>Businesses often juggle separate vendors for IT support, cybersecurity, cabling and security cameras. Homeowners find themselves with connected devices that do not work well together. The systems are connected, but the responsibility is fragmented.</p><p>We built Tech Judge to bring those pieces together. Our team combines IT professionals, C7-licensed low-voltage expertise and luxury automation specialists, with one point of contact across the environment.</p><p>From the server rack to the light switch, we design, install and manage technology with the whole picture in mind.</p></div></div></section>
  <section class="section"><div class="wrap split"><div class="about-photo"><img src={asset('004.png')} width="650" height="450" alt="A professional handshake" loading="lazy" /></div><div><p class="eyebrow">Our mission</p><h2>Confidence in<br/><em>every connection.</em></h2><p class="lead">Be the expert partner clients trust to design, build and manage their technology. Help businesses operate with secure, reliable infrastructure, and make homes feel seamless and intuitive.</p><p class="lead">One unified team. A clear sense of ownership. Technology that supports the people using it.</p></div></div></section>
  <section class="section light"><div class="wrap"><p class="eyebrow">What brings it together</p><h2>Specialist expertise.<br/><em>Shared accountability.</em></h2><div class="process-grid">{[['C7-licensed','California C7 License #1142144 for our low-voltage infrastructure practice.'],['Three disciplines','Managed IT, commercial infrastructure and luxury-home integration under one roof.'],['Trusted technology','A broad technology ecosystem, from SentinelOne and AWS to Brivo, UniFi, Control4 and Lutron.'],['One point of contact','A team that sees how the systems fit together and takes ownership of the whole picture.']].map(([t,p])=><div><h3>{t}</h3><p>{p}</p></div>)}</div><div class="inline-actions"><a class="text-link" href="/partners">Explore our technology partners ↗</a><a class="text-link" href="/careers">Build your career with us ↗</a></div></div></section>
  <ContactBand />
</SiteLayout>
